# 后端镜像构建上下文：只需要 Python 源码、技能与配置

# 版本控制与本地环境
.git
.gitignore
.idea
.vscode
.venv
.python-version
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.DS_Store
*.log
logs/

# 密钥：通过 compose 的 env_file 注入，不进入镜像
.env
.env.*
!.env.example

# 运行时数据（容器内使用卷）
data/

# 与后端镜像无关的目录
frontend/
docs/
tests/
.npm-cache/
.playwright-cli/
output/
evaluation/reports/
