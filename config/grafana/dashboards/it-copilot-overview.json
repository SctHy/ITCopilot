          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "it_copilot_slo_burn_rate{slo=\"chat_availability\",window=\"1h\"}",
          "legendFormat": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
