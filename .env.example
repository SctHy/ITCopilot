IT_COPILOT_PORT=8001

# ── 大模型配置 ────────────────────────────────────────────────────────────────
# 支持任意兼容 OpenAI 接口的模型服务（DeepSeek、OpenAI、本地 Ollama 等）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash

# ── 数据脱敏（发给模型前自动遮盖敏感信息）────────────────────────────────────
# 额外需要脱敏的自定义词列表（JSON 数组，如项目代号、主机名，区分大小写）
IT_COPILOT_MASK_WORDS=[]
# 本地脱敏模型开关：on 强制启用；auto 不可用时自动用规则替代；off 只用正则规则
# 首次使用本地模型前请运行：.venv/bin/python scripts/install_astrlink_guard.py
IT_COPILOT_MASK_MODEL=on
IT_COPILOT_MASK_MODEL_THRESHOLD=0.8
IT_COPILOT_MASK_MODEL_TIMEOUT_S=10
# IT_COPILOT_ASTRLINK_DIR=./data/models/astrlink-guard/7216b6a3b897
# 各场景的模型分配与思考模式开关在 config/model_routes.yaml 中配置

# ── Redis、数据库与知识库检索 ──────────────────────────────────────────────────
REDIS_URL=redis://:it-copilot123@127.0.0.1:6379/0
REDIS_PASSWORD=it-copilot123
# 本地数据目录：未配置 IT_COPILOT_DATABASE_URL 时默认使用 SQLite 文件
IT_COPILOT_DATA_DIR=./data
# 知识库与历史记忆使用的向量化模型（fastembed 支持的名称）；切换模型后会自动重建索引
IT_COPILOT_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
# 知识库默认执行一次混合搜索（关键词 + 向量），以下两个增强项按需开启：
#   RERANK：先取前 20 条再用模型重排，大知识库准确率更高，但每次搜索约多花 1.1 秒
#   REWRITE：先让模型把问题拆成多个子查询并发搜索，会多一次模型调用
IT_COPILOT_RAG_RERANK=false
IT_COPILOT_RAG_REWRITE=false

# ── 身份认证与多租户 ──────────────────────────────────────────────────────────
# dev：本地演示登录（账号见 config/dev_users.yaml），生产环境自动禁用
# oidc：校验 Keycloak 等 OIDC 服务签发的 RS256 令牌，用户和角色完全以令牌为准
IT_COPILOT_AUTH_MODE=dev
# 多进程共享本地 dev 令牌时可固定该密钥；留空则每次启动随机生成
IT_COPILOT_DEV_JWT_SECRET=
# OIDC_ISSUER=http://127.0.0.1:8180/realms/it-copilot
# OIDC_JWKS_URL=          # 留空时默认取 {issuer}/protocol/openid-connect/certs
# OIDC_AUDIENCE=it-copilot

# ── 审批与后台任务执行 ────────────────────────────────────────────────────────
# 审批记录、任务队列和向量数据共用一个数据库；部署推荐使用 PostgreSQL + pgvector：
# IT_COPILOT_DATABASE_URL=postgresql+psycopg://itc:itc-pass@127.0.0.1:5432/it_copilot
IT_COPILOT_DATABASE_URL=
IT_COPILOT_ACCESS_POLICY=./config/access_policy.yaml
# 是否在 API 进程内同时启动后台 Worker（推荐保持 false，另开终端跑 make run-worker）
IT_COPILOT_EMBED_WORKER=false
# Worker 定时兜底扫描间隔（秒）；PostgreSQL 下平时靠 LISTEN/NOTIFY 即时唤醒
IT_COPILOT_WORKER_POLL_S=5
# 收到停止信号后等待当前请求或任务结束的最长秒数
IT_COPILOT_SHUTDOWN_GRACE_S=15
# Worker 独立的健康检查与监控端口（留空则不开启）
# IT_COPILOT_WORKER_METRICS_ADDR=127.0.0.1:8002
# 点击审批通过后，接口最多等待后台执行完成的秒数；超时后直接返回当前状态由 Worker 继续完成
IT_COPILOT_APPROVAL_WAIT_S=5
# Gitea 权限沙箱配置：把 gitlab 权限申请映射到真实的 Gitea 仓库（留空则使用本地模拟数据）
# IT_COPILOT_GITEA_URL=http://127.0.0.1:3001
# IT_COPILOT_GITEA_USER=itc-svc
# IT_COPILOT_GITEA_PASSWORD=
# IT_COPILOT_GITEA_REPOS=gitlab=it-sandbox/platform
# 单次工具调用超时时间（秒）
IT_COPILOT_TOOL_TIMEOUT_S=10
# 定时检查外部权限是否和本地记录一致的间隔（秒，必须为正数）
IT_COPILOT_RECONCILE_INTERVAL_S=900

# ── 限流、多租户与数据清理 ────────────────────────────────────────────────────
# 单个用户的对话限流（格式：次数/秒，填 off 关闭）
# IT_COPILOT_RATE_LIMIT_AGENT_TURN=30/60
# 历史记忆、对话元数据和私聊记录的保留天数（0 表示永久保留；审批和审计日志不自动删除）
# IT_COPILOT_RETENTION_EPISODIC_DAYS=90
# IT_COPILOT_RETENTION_ENABLED=true
IT_COPILOT_RETENTION_TURN_DAYS=90
IT_COPILOT_RETENTION_HISTORY_DAYS=90
# 令牌黑名单与租户状态的本地缓存时间（秒）
# IT_COPILOT_REVOCATION_CACHE_S=5
# IT_COPILOT_TENANT_CACHE_S=5
# 平台运营方租户（该租户下的 platform_admin 才能重载全局技能或管理所有租户）
# IT_COPILOT_PLATFORM_TENANT=default

# ── 对话记忆与技能加载 ────────────────────────────────────────────────────────
IT_COPILOT_MEMORY_MODE=full
# 历史记忆的相似度距离阈值，超过该值说明关联度太低，不加入上下文
IT_COPILOT_MEMORY_MAX_DISTANCE=0.6
# 技能说明加载方式：full 全量放入提示词；progressive 按需加载；auto 按字符上限自动切换
IT_COPILOT_SKILL_DISCLOSURE=auto
IT_COPILOT_SKILL_FULL_MAX_CHARS=6000

# ── 日志与链路追踪 ────────────────────────────────────────────────────────────
# 日志输出格式：json（推荐部署使用）或 text（本地阅读友好）
IT_COPILOT_LOG_FORMAT=json
# OpenTelemetry OTLP gRPC 上报地址（例如 http://127.0.0.1:4317，留空则不上报）
OTEL_EXPORTER_OTLP_ENDPOINT=
# 是否把对话正文写入追踪数据（默认关闭，防止敏感信息外泄）
IT_COPILOT_OTEL_INCLUDE_CONTENT=false
# 当前部署版本 Git Commit（Makefile 和 Docker 构建时自动传入）
IT_COPILOT_BUILD_SHA=
