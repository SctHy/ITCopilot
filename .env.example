IT_COPILOT_PORT=8001
# 模型：PydanticAI 直连 OpenAI-compatible 服务（DeepSeek、OpenAI、本地 Ollama 等）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
# DeepSeek thinking 模式拒绝 required/指定函数的 tool_choice（结构化输出依赖它），需关闭；其他服务留空。
OPENAI_THINKING_TYPE=disabled
# 调用角色、思考档位和轮数由 config/model_routes.yaml 配置；无全局 Agent thinking/rounds 开关。
REDIS_URL=redis://:it-copilot123@127.0.0.1:6379/0
REDIS_PASSWORD=it-copilot123
# 本地数据目录：未设置 IT_COPILOT_DATABASE_URL 时使用 {IT_COPILOT_DATA_DIR}/it_copilot.sqlite3
IT_COPILOT_DATA_DIR=./data
# 知识库与情景记忆的 embedding 模型（fastembed 支持的名称）；换模型会新建集合并从旧集合重新向量化。
IT_COPILOT_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
# 知识检索默认只做一次 hybrid 检索。两个增强可分别开启：
#   RERANK：召回 20 个候选后重排取前 top_k；大知识库上召回明显提升（WixQA Recall@5 0.57→0.77），每次检索多约 1.1 s（Jev 约 0.3 s）。
#   REWRITE：LLM 把查询改写成多个子查询并行召回；多一次模型调用，收益未在大语料上验证。
IT_COPILOT_RAG_RERANK=false
IT_COPILOT_RAG_REWRITE=false
# ── Jev（TypeSafe System One，固定选项判断）────────────────────────────────────
# 有 key 时意图识别走 Jev（置信度低于阈值、超时或失败时转 LLM），同一次请求里还判断两件事：
#   是否需要知识库（需要时把与意图识别并行预取的检索结果附进本轮消息，省掉 Agent 专门检索的一轮）；
#   用户这一轮要求了哪些写操作（建单、权限、重置、解锁；没要求的写操作在执行前拒绝）。
# 没有 key 时这两项不生效，行为与纯 LLM 一致。员工消息会发到 TypeSafe，上线前需过数据合规。
TYPESAFE_API_KEY=
# 意图识别后端：auto（有 key 用 Jev）/ jev / llm
IT_INTENT_BACKEND=auto
IT_INTENT_JEV_THRESHOLD=0.7
IT_INTENT_JEV_TIMEOUT_S=2
# 结果重排后端（仅 IT_COPILOT_RAG_RERANK=true 时生效）：llm / jev。WixQA 上 LLM 重排更准，Jev 更快，默认 llm。
IT_COPILOT_RERANK_BACKEND=llm
# 请求超时和整轮截止时间在 config/model_routes.yaml 配置。

# ── 身份与授权 ────────────────────────────────────────────────────────────────
# dev：本地签发演示身份令牌（config/dev_users.yaml），用于开发、测试与评测；IT_COPILOT_ENV=production 时拒绝。
# oidc：校验 OIDC 提供方（Keycloak）签发的 RS256 令牌；用户、部门、角色只取自令牌。
IT_COPILOT_AUTH_MODE=dev
# 多进程共享 dev 令牌时固定该值；留空则每次启动随机生成。
IT_COPILOT_DEV_JWT_SECRET=
# OIDC_ISSUER=http://127.0.0.1:8180/realms/it-copilot
# OIDC_JWKS_URL=          # 留空时为 {issuer}/protocol/openid-connect/certs
# OIDC_AUDIENCE=it-copilot

# ── 审批与执行 ────────────────────────────────────────────────────────────────
# 审批、执行与向量（知识库、记忆）共用一个库。留空时使用本地 SQLite；部署用 PostgreSQL（需 pgvector 扩展），例如：
# IT_COPILOT_DATABASE_URL=postgresql+psycopg://itc:itc-pass@127.0.0.1:5432/it_copilot
IT_COPILOT_DATABASE_URL=
IT_COPILOT_ACCESS_POLICY=./config/access_policy.yaml
# API 进程内是否运行执行 worker（独立 worker：python -m workflow.worker）
IT_COPILOT_WORKER_ENABLED=true
# 批准接口最多等待执行完成的秒数；超时返回 queued/executing，由 worker 继续执行
IT_COPILOT_APPROVAL_WAIT_S=5
# 真实权限系统沙箱：把 gitlab 权限映射到 Gitea 仓库协作者（留空则全部走本地目录）
# IT_COPILOT_GITEA_URL=http://127.0.0.1:3001
# IT_COPILOT_GITEA_USER=itc-svc
# IT_COPILOT_GITEA_PASSWORD=
# IT_COPILOT_GITEA_REPOS=gitlab=it-sandbox/platform
# 单次 Agent 工具调用超时（统一工具执行层）
IT_COPILOT_TOOL_TIMEOUT_S=10

# ── 限流与数据保留（ADR 0018）──────────────────────────────────────────────────
# 每个身份启动模型工作的请求上限（/chat、/chat/stream、要求 Agent 回复的事项消息、飞书消息共用）：次数/秒；off 关闭
# IT_COPILOT_RATE_LIMIT_AGENT_TURN=30/60
# 保留天数：处理完的飞书收发消息、情景记忆；0 表示永久保留。审批、执行与审计记录不清理。
# IT_COPILOT_RETENTION_CHANNEL_DAYS=30
# IT_COPILOT_RETENTION_EPISODIC_DAYS=90
# IT_COPILOT_RETENTION_ENABLED=true
# 令牌吊销查询在每个进程的缓存秒数：吊销最晚在这个时间内对所有进程生效（ADR 0019）
# IT_COPILOT_REVOCATION_CACHE_S=5
# 多租户开关（ADR 0022）：开启后令牌里的租户必须在注册表中且为 active（scripts/tenants.py 管理），且只支持 PostgreSQL
# IT_COPILOT_MULTI_TENANT=false
# 租户注册表查询在每个进程的缓存秒数：停用租户最晚在这个时间内对所有进程生效
# IT_COPILOT_TENANT_CACHE_S=5
# 租户策略覆盖目录（ADR 0025）：<tenant>.yaml 只能收紧 config/access_policy.yaml，示例见 config/policies/acme.yaml.sample
# IT_COPILOT_POLICY_DIR=config/policies
# 运营方租户：多租户模式下只有这个租户里带 platform_admin 角色的人能重载技能、执行数据清理、复核所有租户的策略；
# 部署自己的 Gitea（IT_COPILOT_GITEA_*）也只为这个租户执行
# IT_COPILOT_PLATFORM_TENANT=default
# 各租户自己的目标系统与凭据（凭据只写环境变量名），示例见 config/tenant_adapters.yaml.sample
# IT_COPILOT_TENANT_ADAPTERS=config/tenant_adapters.yaml

# ── 飞书机器人（intake/feishu.py，ADR 0009）──────────────────────────────────
# 留空 FEISHU_APP_ID 则不启用。开放平台：事件订阅地址 https://<公网域名>/channels/feishu/events，
# 订阅 im.message.receive_v1；权限 im:message、im:message:send_as_bot（群里追问免 @ 还需 im:message.group_msg）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件订阅页的 Verification Token（必填）与 Encrypt Key（建议填写：启用签名校验与解密）
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 签名请求的时间戳与本机时钟允许的最大偏差（秒），超出视为重放；仅在配置 Encrypt Key 时生效
# FEISHU_MAX_CLOCK_SKEW_S=300
# 机器人 open_id；留空时启动时通过 /bot/v3/info 获取（用于识别群里的 @）
FEISHU_BOT_OPEN_ID=
# 只监听这些群（逗号分隔 chat_id）；留空监听机器人所在的全部群，私聊不受限
FEISHU_ALLOWED_CHATS=
# 飞书用户 → IT-Copilot 身份映射；未映射的人不受理
# FEISHU_USERS=./config/feishu_users.yaml
# 收到消息时加的表情回应（不产生通知）；留空则不回应
FEISHU_ACK_EMOJI=OnIt

# ── 共享事项站外通知（ADR 0014）──────────────────────────────────────────────
# 联系人键为 tenant:subject，值只能由服务端配置。OIDC 需使用真实 sub，不能照抄 dev 示例。
# IT_COPILOT_TASK_CONTACTS={"default:dev:alice":{"email":"alice@example.invalid"}}
IT_COPILOT_TASK_CONTACTS={}
# 网页链接；Compose 默认网页在 http://127.0.0.1:8080，生产填写对外 HTTPS 地址。
IT_COPILOT_PUBLIC_WEB_URL=http://127.0.0.1:5173
# SMTP 使用 STARTTLS；HOST 和 FROM 均有值才启用邮件。飞书复用上面的客户端配置。
IT_COPILOT_SMTP_HOST=
IT_COPILOT_SMTP_PORT=587
IT_COPILOT_SMTP_FROM=
IT_COPILOT_SMTP_USERNAME=
IT_COPILOT_SMTP_PASSWORD=

# ── 外部 MCP 工具（config/mcp_servers.json）────────────────────────────────────
# 默认关闭：开启后 Agent 可能把员工问题发送给第三方 MCP 服务（默认配置为微软 Learn 文档检索）。
IT_COPILOT_MCP_ENABLED=false
# IT_COPILOT_MCP_CONFIG=./config/mcp_servers.json

# ── 监控与 SLO（monitor/performance_monitor.py）────────────────────────────────
IT_COPILOT_MONITOR_INTERVAL_S=10
IT_COPILOT_SLO_AVAILABILITY=0.95
IT_COPILOT_SLO_LATENCY_S=10
IT_COPILOT_SLO_LATENCY_TARGET=0.95
# 告警状态迁移（触发 / 升级 / 恢复）时 POST JSON 到该地址，可对接飞书 / 企业微信机器人中转。
IT_COPILOT_ALERT_WEBHOOK=
# 会话压缩与画像提炼的后台 worker 数
IT_COPILOT_MEMORY_WORKERS=2
IT_COPILOT_MEMORY_MODE=full
# 情景记忆的余弦距离门槛：超过即视为与当前问题无关，不放进上下文（jina-v2-base-zh 上小样本校准为 0.6）。
IT_COPILOT_MEMORY_MAX_DISTANCE=0.6
# 技能披露：full（全部正文进 system，命中前缀缓存）/ progressive（system 只放目录，相关正文进本轮消息）/
# auto（总长不超过 IT_COPILOT_SKILL_FULL_MAX_CHARS 用 full，否则 progressive）。
IT_COPILOT_SKILL_DISCLOSURE=auto
IT_COPILOT_SKILL_FULL_MAX_CHARS=6000

# ── 链路追踪（OpenTelemetry）────────────────────────────────────────────────────
# 设置后启用，填 OTLP gRPC 收集端地址（如 http://127.0.0.1:4317）。
OTEL_EXPORTER_OTLP_ENDPOINT=
# 默认不把 prompt / 模型输出写入 span（可能含员工信息）
IT_COPILOT_OTEL_INCLUDE_CONTENT=false

# 部署版本；Docker 构建必须传入，start_local.sh 自动取 git revision。
IT_COPILOT_BUILD_SHA=
# 元数据保留90天，0禁用清理；正文仅留在短期Redis trace。
IT_COPILOT_RETENTION_TURN_DAYS=90

# 只读授权漂移巡检间隔；须为正的有限秒数，配置非法时启动失败。
