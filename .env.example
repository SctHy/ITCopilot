IT_COPILOT_PORT=8001
ANTHROPIC_API_KEY=sk-local
ANTHROPIC_BASE_URL=http://127.0.0.1:8082
ANTHROPIC_MODEL=deepseek-chat
# PydanticAI 模型 provider：anthropic（默认，经 8082 协议网关）| openai（直连 OpenAI-compatible，无需网关）
IT_COPILOT_LLM_PROVIDER=anthropic
# provider=openai 时使用：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
REDIS_URL=redis://:it-copilot123@127.0.0.1:6379/0
REDIS_PASSWORD=it-copilot123
CHROMA_PERSIST_DIRECTORY=./data/chroma
# 单个 LLM 工具调用轮次的等待上限（秒）；需小于网关 GATEWAY_TIMEOUT_S（默认 120）
IT_COPILOT_LLM_TIMEOUT_S=90
# 可选：启动独立 gateway 时填写真实 OpenAI-compatible 配置
IT_COPILOT_GATEWAY_ENV=./gateway/.env.gateway
