IT_COPILOT_PORT=8001
ANTHROPIC_API_KEY=sk-local
ANTHROPIC_BASE_URL=http://127.0.0.1:8082
ANTHROPIC_MODEL=deepseek-chat
# PydanticAI 模型 provider：anthropic（默认，经 8082 协议网关）| openai（直连 OpenAI-compatible，无需网关）
IT_COPILOT_LLM_PROVIDER=anthropic
# provider=openai 时使用：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
REDIS_URL=redis://:it-copilot123@127.0.0.1:6379/0
REDIS_PASSWORD=it-copilot123
CHROMA_PERSIST_DIRECTORY=./data/chroma
# 单个 LLM 工具调用轮次的等待上限（秒）；需小于网关 GATEWAY_TIMEOUT_S（默认 120）
IT_COPILOT_LLM_TIMEOUT_S=90
# 可选：启动独立 gateway 时填写真实 OpenAI-compatible 配置
IT_COPILOT_GATEWAY_ENV=./gateway/.env.gateway

# ── 身份与授权 ────────────────────────────────────────────────────────────────
# dev：本地签发演示身份令牌（config/dev_users.yaml），用于开发、测试与评测；IT_COPILOT_ENV=production 时拒绝。
# oidc：校验 OIDC 提供方（Keycloak）签发的 RS256 令牌；用户、部门、角色只取自令牌。
IT_COPILOT_AUTH_MODE=dev
# 多进程共享 dev 令牌时固定该值；留空则每次启动随机生成。
IT_COPILOT_DEV_JWT_SECRET=
# OIDC_ISSUER=http://127.0.0.1:8180/realms/it-copilot
# OIDC_JWKS_URL=          # 留空时为 {issuer}/protocol/openid-connect/certs
# OIDC_AUDIENCE=it-copilot

# ── 审批与执行 ────────────────────────────────────────────────────────────────
# 留空时使用 {CHROMA_PERSIST_DIRECTORY}/workflow.sqlite3；部署用 PostgreSQL，例如：
# IT_COPILOT_DATABASE_URL=postgresql+psycopg://itc:itc-pass@127.0.0.1:5432/it_copilot
IT_COPILOT_DATABASE_URL=
IT_COPILOT_ACCESS_POLICY=./config/access_policy.yaml
# API 进程内是否运行执行 worker（独立 worker：python -m workflow.worker）
IT_COPILOT_WORKER_ENABLED=true
# 批准接口最多等待执行完成的秒数；超时返回 queued/executing，由 worker 继续执行
IT_COPILOT_APPROVAL_WAIT_S=5
# 真实权限系统沙箱：把 gitlab 权限映射到 Gitea 仓库协作者（留空则全部走本地目录）
# IT_COPILOT_GITEA_URL=http://127.0.0.1:3001
# IT_COPILOT_GITEA_USER=itc-svc
# IT_COPILOT_GITEA_PASSWORD=
# IT_COPILOT_GITEA_REPOS=gitlab=it-sandbox/platform
# 单次 Agent 工具调用超时（统一工具执行层）
IT_COPILOT_TOOL_TIMEOUT_S=10

# ── 外部 MCP 工具（config/mcp_servers.json）────────────────────────────────────
# 默认关闭：开启后 Agent 可能把员工问题发送给第三方 MCP 服务（默认配置为微软 Learn 文档检索）。
IT_COPILOT_MCP_ENABLED=false
# IT_COPILOT_MCP_CONFIG=./config/mcp_servers.json

# ── 监控与 SLO（monitor/performance_monitor.py）────────────────────────────────
IT_COPILOT_MONITOR_INTERVAL_S=10
IT_COPILOT_SLO_AVAILABILITY=0.95
IT_COPILOT_SLO_LATENCY_S=10
IT_COPILOT_SLO_LATENCY_TARGET=0.95
# 告警状态迁移（触发 / 升级 / 恢复）时 POST JSON 到该地址，可对接飞书 / 企业微信机器人中转。
IT_COPILOT_ALERT_WEBHOOK=
# 路由降权 ≥ 该值时专职 Agent 进入冷却，请求由 Triage 兜底；冷却结束放行单个探针。
IT_COPILOT_MONITOR_FALLBACK_PENALTY=0.5
IT_COPILOT_MONITOR_COOLDOWN_SECONDS=60
# 会话压缩与画像提炼的后台 worker 数
IT_COPILOT_MEMORY_WORKERS=2
# Runtime defaults: structured LLM intent + labelled rule fallback; fusion available for ablation.
IT_INTENT_STRATEGY=llm
# generalist（默认，一个 Agent 全部工具）| bounded（LLM 规划 + 专职 Agent，权限隔离）| bounded_all | single
IT_COPILOT_PLANNING_MODE=generalist
IT_COPILOT_MEMORY_MODE=full

# ── 链路追踪（OpenTelemetry）────────────────────────────────────────────────────
# 设置后启用；docker compose --profile observability 下填 http://jaeger:4317，本机 Jaeger 填 http://127.0.0.1:4317。
OTEL_EXPORTER_OTLP_ENDPOINT=
# 默认不把 prompt / 模型输出写入 span（可能含员工信息）
IT_COPILOT_OTEL_INCLUDE_CONTENT=false
